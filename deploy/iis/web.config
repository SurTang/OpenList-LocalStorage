<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 部署配置（使用 HttpPlatformHandler 直接托管 openlist.exe）

  前置条件：
  1. 安装 IIS，并勾选「Web 服务器 (IIS) → 应用程序开发 → CGI」；
  2. 安装 HttpPlatformHandler v1.2（微软官方模块）；
  3. 把 openlist.exe 放在站点根目录（与 web.config 同级），数据目录默认是站点下的 data 文件夹。

  HttpPlatformHandler 会把随机端口写入 %HTTP_PLATFORM_PORT%，
  下面的环境变量把它传给程序，程序只监听 127.0.0.1，公网访问统一由 IIS 转发。
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="OpenListHttpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>
    <httpPlatform processPath=".\openlist.exe"
                  arguments="server --data .\data"
                  startupTimeLimit="60"
                  requestTimeout="00:30:00"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout">
      <environmentVariables>
        <environmentVariable name="OPENLIST_HTTP_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="OPENLIST_ADDR" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- 允许上传大文件；如仍受限制，请在 IIS 管理器中调整 maxAllowedContentLength -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
